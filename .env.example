# Copy to .env. Paths refer to the EC2 host. This file contains no secrets.
COMPOSE_PROJECT_NAME=learnable-judge0
JUDGE0_CONFIG=/opt/learnable-judge0/secrets/judge0.conf
TLS_DIR=/opt/learnable-judge0/secrets/tls
# For existing data, set these to the exact inspected volume names before up.
POSTGRES_VOLUME=learnable-judge0-postgres
REDIS_VOLUME=learnable-judge0-redis
# Review these budgets against host RAM/CPU before deployment.
API_MEMORY=512m
WORKER_MEMORY=768m
DB_MEMORY=384m
REDIS_MEMORY=128m
API_CPUS=0.50
WORKER_CPUS=1.0
DB_CPUS=0.50
REDIS_CPUS=0.25
